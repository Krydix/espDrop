menu "espDrop"

config ESPDROP_DEVICE_NAME
    string "AirDrop device name"
    default "espDrop"

config ESPDROP_MAX_TRANSFER_BYTES
    int "Maximum accepted transfer size"
    range 1024 2147483647
    default 67108864

config ESPDROP_AWDL_PROBE
    bool "Enable receive-only AWDL action-frame probe"
    default y

config ESPDROP_AWDL_PROBE_CHANNEL
    int "AWDL probe channel"
    depends on ESPDROP_AWDL_PROBE
    range 1 13
    default 6

config ESPDROP_AWDL_TX_LAB
    bool "Enable bounded AWDL action/data transmit experiment"
    depends on ESPDROP_AWDL_PROBE
    default n
    help
        Research-only profile. After observing an OWL-valid MIF, derive and
        seed the peer's RFC4291 link-local mapping, then transmit PSF/MIF and
        queued IPv6 frames in bounded common windows for 15 seconds. The TLS
        sub-profile extends that bound to 25 seconds. Normal and web-flasher
        builds must leave this disabled.

config ESPDROP_AWDL_NETIF
    bool "Attach decoded AWDL IPv6 to an ESP-IDF network interface"
    depends on ESPDROP_AWDL_PROBE
    default y
    help
        Creates an Ethernet-shaped esp-netif for lwIP and feeds it decoded
        AWDL frames. Normal firmware suppresses all packets lwIP asks the
        driver to transmit; radio output remains restricted to a lab profile.

config ESPDROP_AWDL_MDNS_LAB
    bool "Run bounded IPv6 mDNS query through the AWDL netif"
    depends on ESPDROP_AWDL_NETIF && ESPDROP_AWDL_TX_LAB
    default n
    help
        Joins ff02::fb on the AWDL interface and sends six PTR queries for
        _airdrop._tcp.local after the selected peer supplies an OWL-valid MIF
        with version and device class. Only use in the bounded transmit lab.

config ESPDROP_AIRDROP_TLS_LAB
    bool "Perform one bounded AirDrop TLS client handshake"
    depends on ESPDROP_AWDL_MDNS_LAB
    default n
    help
        After TCP reaches a dynamically resolved AirDrop receiver, perform one
        TLS handshake using a lab-only self-signed client certificate. Peer
        certificate verification is disabled to match OpenDrop's documented
        Everyone-mode behavior. Normal and web-flasher builds must leave this
        disabled.

config ESPDROP_AIRDROP_ASK_LAB
    bool "Issue one bounded AirDrop /Ask on a sender connection"
    depends on ESPDROP_AIRDROP_TLS_LAB
    default n
    help
        After DNS-SD discovery, open the sender TLS connection with one
        synthetic hello.jpg transfer intent and record its bounded response.
        This follows OpenDrop's send flow: /Ask is the first request on this
        connection, rather than following /Discover. It can create an AirDrop
        prompt on the receiver. It never sends /Upload. Enable only for an
        attended lab run with explicit user consent.

config ESPDROP_AIRDROP_UPLOAD_LAB
    bool "Send one bounded hello.jpg after accepted /Ask"
    depends on ESPDROP_AIRDROP_ASK_LAB
    default n
    help
        After the user accepts the attended /Ask, send one deterministic JPEG
        in a zlib-compressed ODC cpio archive using the observed chunked dvzip
        framing and Apple-order headers. The accepted TLS connection and exact
        TransferID are reused. There is no retry. Normal and web-flasher builds
        must leave this disabled.

config ESPDROP_AWDL_LAB_TARGET_MAC
    string "AWDL lab endpoint MAC (empty permits auto-selection)"
    depends on ESPDROP_AWDL_TX_LAB
    default ""
    help
        Optional colon-separated AWDL peer MAC that receives the research
        lab's direct IPv6 traffic. AirDrop endpoint tests are restricted to
        the same peer. Production builds leave this empty.

config ESPDROP_AWDL_LAB_AUTO_TARGET_AIRDROP
    bool "Automatically target a live AirDrop TCP advertiser"
    depends on ESPDROP_AWDL_TX_LAB
    default n
    help
        When no explicit target MAC is configured, remain passive until a
        parsed MIF service response advertises _airdrop._tcp, then bind the
        bounded experiment to that ephemeral peer in RAM. This avoids losing
        short-lived Apple peer identities while rebuilding firmware. An
        explicit target MAC always takes precedence. Production builds leave
        this disabled.

config ESPDROP_AWDL_LAB_SCHEDULE_MAC
    string "AWDL lab schedule-source MAC"
    depends on ESPDROP_AWDL_TX_LAB
    default ""
    help
        Optional AWDL peer whose MIF supplies the channel sequence and timing.
        This can differ from the endpoint peer. The MIF's election TLV still
        supplies the actual synchronization-master identity. When empty, the
        endpoint MAC is the schedule source. Production builds leave this
        empty.

config ESPDROP_AWDL_LAB_DYNAMIC_ELECTION
    bool "Continuously elect the AWDL synchronization parent"
    depends on ESPDROP_AWDL_TX_LAB
    default y
    help
        Track fresh MIFs from all observed peers and continuously select the
        synchronization parent using the OWL election algorithm. The selected
        parent's timing and channel sequence replace the fixed schedule-source
        override. Normal and web-flasher builds never transmit regardless of
        this setting.

config TAPDROP_NFC_FIELD_GPIO
    int "NFC field-detect GPIO (-1 disables hardware input)"
    range -1 48
    default -1

config TAPDROP_NFC_ACTIVE_LEVEL
    int "NFC field-detect active level"
    range 0 1
    default 1

config TAPDROP_SESSION_WINDOW_MS
    int "Tap correlation window (milliseconds)"
    range 1000 60000
    default 15000

config TAPDROP_MINIMUM_SCORE
    int "Minimum correlation score"
    range 0 1000
    default 450

config TAPDROP_AMBIGUITY_MARGIN
    int "Required score margin over second candidate"
    range 0 1000
    default 100

endmenu
