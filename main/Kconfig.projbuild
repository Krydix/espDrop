menu "espDrop"

config ESPDROP_DEVICE_NAME
    string "AirDrop device name"
    default "espDrop"

config ESPDROP_MAX_TRANSFER_BYTES
    int "Maximum accepted transfer size"
    range 1024 2147483647
    default 67108864

config ESPDROP_AWDL_PROBE
    bool "Enable receive-only AWDL action-frame probe"
    default y

config ESPDROP_AWDL_PROBE_CHANNEL
    int "AWDL probe channel"
    depends on ESPDROP_AWDL_PROBE
    range 1 13
    default 6

config ESPDROP_AWDL_TX_LAB
    bool "Enable bounded AWDL action/data transmit experiment"
    depends on ESPDROP_AWDL_PROBE
    default n
    help
        Research-only profile. After observing a valid MIF, transmit PSF/MIF
        action frames plus bounded IPv6 neighbor and echo probes for no more
        than 15 seconds. Normal and web-flasher builds must leave this disabled.

config ESPDROP_AWDL_NETIF
    bool "Attach decoded AWDL IPv6 to an ESP-IDF network interface"
    depends on ESPDROP_AWDL_PROBE
    default y
    help
        Creates an Ethernet-shaped esp-netif for lwIP and feeds it decoded
        AWDL frames. Normal firmware suppresses all packets lwIP asks the
        driver to transmit; radio output remains restricted to a lab profile.

config ESPDROP_AWDL_MDNS_LAB
    bool "Run bounded IPv6 mDNS query through the AWDL netif"
    depends on ESPDROP_AWDL_NETIF && ESPDROP_AWDL_TX_LAB
    default n
    help
        Joins ff02::fb on the AWDL interface and sends six PTR queries for
        _airdrop._tcp.local. Only use in the bounded transmit lab.

config ESPDROP_AWDL_LAB_TARGET_MAC
    string "AWDL lab target MAC (empty selects automatically)"
    depends on ESPDROP_AWDL_TX_LAB
    default ""
    help
        Optional colon-separated AWDL peer MAC used only by the research lab.
        When set, the transmitter waits for that peer's MIF and follows its
        synchronization/channel sequence. Production builds leave this empty.

config TAPDROP_NFC_FIELD_GPIO
    int "NFC field-detect GPIO (-1 disables hardware input)"
    range -1 48
    default -1

config TAPDROP_NFC_ACTIVE_LEVEL
    int "NFC field-detect active level"
    range 0 1
    default 1

config TAPDROP_SESSION_WINDOW_MS
    int "Tap correlation window (milliseconds)"
    range 1000 60000
    default 15000

config TAPDROP_MINIMUM_SCORE
    int "Minimum correlation score"
    range 0 1000
    default 450

config TAPDROP_AMBIGUITY_MARGIN
    int "Required score margin over second candidate"
    range 0 1000
    default 100

endmenu
