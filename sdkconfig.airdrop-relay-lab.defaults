CONFIG_ESPDROP_AWDL_TX_LAB=y
# CONFIG_ESPDROP_AWDL_ACTIVE_RX_LAB is not set
CONFIG_ESPDROP_BLE_WAKE_LAB=y
CONFIG_ESPDROP_BLE_WAKE_DURATION_MS=120000
CONFIG_ESPDROP_AWDL_MDNS_LAB=y
CONFIG_ESPDROP_AIRDROP_TLS_LAB=y
CONFIG_ESPDROP_AIRDROP_ASK_LAB=y
CONFIG_ESPDROP_AIRDROP_UPLOAD_LAB=y
CONFIG_ESPDROP_RELAY_ARM_WINDOW_MS=15000
CONFIG_ESPDROP_AWDL_LAB_DYNAMIC_ELECTION=y
CONFIG_ESPDROP_AWDL_LAB_AUTO_TARGET_AIRDROP=y
CONFIG_ESPDROP_AWDL_LAB_TARGET_MAC=""
CONFIG_ESPDROP_AWDL_AUTO_TARGET_SETTLE_MS=1000
CONFIG_ESPDROP_AWDL_AUTO_TARGET_MAX_AGE_MS=3000
CONFIG_ESPDROP_AWDL_AUTO_TARGET_MIN_RSSI=-70
CONFIG_ESPDROP_AWDL_AUTO_TARGET_MARGIN_DB=8
# Keep the anonymous sender's TLS record buffers and handshake objects out of
# scarce internal DRAM. The S3 prototype has PSRAM and this lab profile runs
# Wi-Fi promiscuous mode, lwIP, NimBLE, and mbedTLS concurrently.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
